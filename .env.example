# Copy this file to .env and fill in your real sender account.
# For Gmail, create an App Password and use it as GDC_SMTP_PASS.

GDC_SERVER_PORT=3000

GDC_SMTP_HOST=smtp.gmail.com
GDC_SMTP_PORT=587
GDC_SMTP_SECURE=false
GDC_SMTP_USER=yourclubmail@gmail.com
GDC_SMTP_PASS=your-app-password

GDC_MAIL_FROM=yourclubmail@gmail.com
GDC_MAIL_FROM_NAME=Game Development Club
GDC_MAIL_REPLY_TO=yourclubmail@gmail.com
